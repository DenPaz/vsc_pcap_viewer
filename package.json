        "mac": "cmd+/",
        "when": "activeCustomEditorId =~ /^pcapViewer\\.editor(Optional)?$/"
      },
      {
        "command": "pcapViewer.goToPacket",
        "key": "ctrl+g",
        "mac": "cmd+g",
        "when": "activeCustomEditorId =~ /^pcapViewer\\.editor(Optional)?$/"
      },
      {
        "command": "pcapViewer.toggleMark",
        "key": "ctrl+m",
        "mac": "cmd+m",
        "when": "activeCustomEditorId =~ /^pcapViewer\\.editor(Optional)?$/ && !sideBarFocus && !panelFocus && !auxiliaryBarFocus && !inputFocus"
      },
      {
        "command": "pcapViewer.nextMark",
        "key": "ctrl+shift+n",
        "mac": "cmd+shift+n",
        "when": "activeCustomEditorId =~ /^pcapViewer\\.editor(Optional)?$/ && !sideBarFocus && !panelFocus && !auxiliaryBarFocus && !inputFocus"
      },
