    "configuration": {
      "title": "PCAP Viewer",
      "properties": {
        "pcapViewer.pythonPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Python 3.14+ interpreter used to run the backend. Empty: try `python3.14`, `python3`, `python` (or `py -3.14` / `py -3` on Windows) from `PATH`."
        },
        "pcapViewer.tsharkPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Path to `tshark`. Empty: search `PATH` and the default Wireshark install locations."
        },
        "pcapViewer.luaScripts": {
          "type": "array",
          "scope": "resource",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Lua dissector scripts passed to tshark as `-X lua_script:<path>`. Relative paths resolve against the first workspace folder."
        },
        "pcapViewer.dissectorsFolder": {
          "type": "string",
          "scope": "resource",
          "default": "",
          "markdownDescription": "Folder whose `*.lua` files are loaded as dissectors in addition to `#pcapViewer.luaScripts#`. Relative paths resolve against the first workspace folder."
        },
        "pcapViewer.decodeAs": {
          "type": "array",
          "scope": "resource",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.\\-]*(==|:)[^,\\s]+,[A-Za-z0-9_.\\-]+$",
            "patternErrorMessage": "Expected <layer>==<value>,<protocol>, e.g. tcp.port==8080,http"
          },
          "default": [],
          "markdownDescription": "\"Decode As\" rules passed to tshark as `-d`, e.g. `tcp.port==8080,http`."
        },
        "pcapViewer.prefs": {
          "type": "object",
          "scope": "resource",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          "default": {},
          "markdownDescription": "Wireshark preference overrides passed as `-o <name>:<value>`, e.g. `{ \"tcp.desegment_tcp_streams\": false }`."
        },
        "pcapViewer.tlsKeyLogFile": {
          "type": "string",
          "scope": "resource",
          "default": "",
          "markdownDescription": "Key log file (the `SSLKEYLOGFILE` format browsers and curl write) used to decrypt TLS and QUIC traffic; passed to tshark as the `tls.keylog_file` preference (it overrides one in `#pcapViewer.prefs#`). Relative paths resolve against the capture's workspace folder. Set it with **PCAP: Set TLS Key Log File…**; changing it reloads the captures it applies to, and the viewer offers a reload when the file changes."
        },
        "pcapViewer.columns": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "field": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  }
                },
                "required": [
                  "field"
                ]
              }
            ]
          },
          "default": [],
          "markdownDescription": "Extra packet-list columns: any tshark field (e.g. `tcp.stream`, `http.host`) or `{ \"field\": \"http.host\", \"title\": \"Host\" }`.",
          "scope": "resource"
        },
        "pcapViewer.columnLayout": {
          "type": "object",
          "scope": "resource",
          "default": {},
          "properties": {
            "order": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Column ids in display order (number, time, source, destination, protocol, length, info, custom:<field>)"
            },
            "hidden": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Column ids that are hidden"
            }
          },
          "markdownDescription": "Packet list column order and hidden columns, by column id (`number`, `time`, `source`, `destination`, `protocol`, `length`, `info`, `custom:<field>`). Set by dragging headers and the header context menu."
        },
        "pcapViewer.timeFormat": {
          "type": "string",
          "scope": "resource",
          "default": "relative",
          "enum": [
            "relative",
            "delta_displayed",
            "delta_captured",
            "absolute",
            "utc",
            "epoch"
          ],
          "enumDescriptions": [
            "Seconds since beginning of capture (or since the time reference)",
            "Seconds since previous displayed packet (follows the filter and sort order)",
            "Seconds since previous captured packet",
            "Date and time of day, local time",
            "Date and time of day, UTC",
            "Seconds since 1970-01-01"
          ],
          "markdownDescription": "How the packet list shows the Time column (*PCAP: Time Display Format\u2026*, or click the time format in the status bar)."
        },
        "pcapViewer.savedFilters": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "filter": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "filter"
            ]
          },
          "default": [],
          "markdownDescription": "Named display filters, e.g. `{ \"name\": \"Web\", \"filter\": \"http || tls\" }`. Shown in the filter bar's \u2605 menu and *PCAP: Saved Display Filters*. Set in user settings for all captures or in workspace settings to share with a project."
        },
        "pcapViewer.colorize": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "Color the packet list with `#pcapViewer.coloringRules#` (*PCAP: Toggle Packet Coloring*)."
        },
        "pcapViewer.coloringRules": {
          "type": "array",
          "scope": "resource",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "filter": {
                "type": "string",
                "description": "Display filter"
              },
              "foreground": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$",
                "patternErrorMessage": "Use a #rrggbb color",
                "description": "Text color"
              },
              "background": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$",
                "patternErrorMessage": "Use a #rrggbb color",
                "description": "Row color"
              },
              "enabled": {
                "type": "boolean",
                "default": true
              }
            },
            "required": [
              "name",
              "filter"
            ]
          },
          "default": [
            {
              "name": "Bad TCP",
              "filter": "tcp.analysis.flags && !tcp.analysis.window_update && !tcp.analysis.keep_alive && !tcp.analysis.keep_alive_ack",
              "foreground": "#f78787",
              "background": "#12272e"
            },
            {
              "name": "Checksum Errors",
              "filter": "eth.fcs.status == \"Bad\" || ip.checksum.status == \"Bad\" || tcp.checksum.status == \"Bad\" || udp.checksum.status == \"Bad\" || sctp.checksum.status == \"Bad\"",
              "foreground": "#f78787",
              "background": "#12272e"
            },
            {
              "name": "TCP RST",
              "filter": "tcp.flags.reset == 1",
              "foreground": "#fffc9c",
              "background": "#a40000"
            },
            {
              "name": "ICMP errors",
              "filter": "icmp.type == 3 || icmp.type == 4 || icmp.type == 5 || icmp.type == 11 || (icmpv6.type >= 1 && icmpv6.type <= 4)",
              "foreground": "#b7f774",
              "background": "#12272e"
            },
            {
              "name": "ARP",
              "filter": "arp",
              "foreground": "#12272e",
              "background": "#faf0d7"
            },
            {
              "name": "ICMP",
              "filter": "icmp || icmpv6",
              "foreground": "#12272e",
              "background": "#fce0ff"
            },
            {
              "name": "TCP SYN/FIN",
              "filter": "tcp.flags & 0x02 || tcp.flags.fin == 1",
              "foreground": "#12272e",
              "background": "#a0a0a0"
            },
            {
              "name": "HTTP",
              "filter": "http || tcp.port == 80 || http2",
              "foreground": "#12272e",
              "background": "#e4ffc7"
            },
            {
              "name": "DNS",
              "filter": "dns || mdns || llmnr",
              "foreground": "#12272e",
              "background": "#c8e2ff"
            },
            {
              "name": "SMB",
              "filter": "smb || nbss || nbns || netbios",
              "foreground": "#12272e",
              "background": "#feffd0"
            },
            {
              "name": "Routing",
              "filter": "hsrp || eigrp || ospf || bgp || cdp || vrrp || carp || gvrp || igmp || ismp",
              "foreground": "#12272e",
              "background": "#fff3d6"
            },
            {
              "name": "TCP",
              "filter": "tcp",
              "foreground": "#12272e",
              "background": "#e7e6ff"
            },
            {
              "name": "UDP",
              "filter": "udp",
              "foreground": "#12272e",
              "background": "#daeeff"
            },
            {
              "name": "Broadcast",
              "filter": "eth[0] & 1",
              "foreground": "#babdb6",
              "background": "#ffffff"
            }
          ],
          "markdownDescription": "Packet list coloring rules, like Wireshark's *View \u203a Coloring Rules*: the **first** rule whose display filter matches colors the packet. Colors are `#rrggbb`; set `\"enabled\": false` to keep a rule without using it. *Colorize with Filter\u2026* in the detail tree's context menu adds a rule at the top."
        },
        "pcapViewer.maxCachedFrames": {
          "type": "integer",
          "default": 5000000,
          "minimum": 10000,
          "markdownDescription": "Budget (in frame numbers) for cached filter results and sort orders in the backend. Each entry costs 4 bytes."
        },
        "pcapViewer.indexCache.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Save each capture's packet-list index (the result of the first tshark pass over the file) in the extension's storage, so reopening it is instant as long as the file and everything that changes dissection (tshark version, Lua scripts, Decode As rules, preferences, custom columns, your Wireshark configuration) are unchanged. The index holds the packet list's text (addresses, Info column). *PCAP: Clear Index Cache* deletes them all."
        },
        "pcapViewer.indexCache.maxSizeMB": {
          "type": "integer",
          "default": 1024,
          "minimum": 0,
          "markdownDescription": "Most disk space (MB) the saved indexes of `#pcapViewer.indexCache.enabled#` may use; the least recently opened captures' indexes go first. An index takes about 120 MB per million packets."
        },
        "pcapViewer.quickDetail.after": {
          "type": "integer",
          "default": 20000,
          "minimum": 0,
          "markdownDescription": "Showing a packet's details dissects the capture from the start up to that packet, so late packets in big captures take long (seconds per 100,000 packets). From this frame number on, a quick view comes first: only the `#pcapViewer.quickDetail.window#` packets before it are dissected (cut out with editcap), then the exact view replaces it. The quick view is marked approximate: reassembly, TCP analysis and conversation details that depend on earlier packets can be missing. `0` turns it off."
        },
        "pcapViewer.quickDetail.window": {
          "type": "integer",
          "default": 300,
          "minimum": 2,
          "maximum": 5000,
          "markdownDescription": "How many packets (up to and including the selected one) the quick view of `#pcapViewer.quickDetail.after#` dissects. More packets give more context (e.g. longer TCP reassembly) and take a little longer."
        },
        "pcapViewer.requestTimeoutSeconds": {
          "type": "integer",
          "default": 60,
          "minimum": 5,
          "markdownDescription": "Timeout for quick backend requests (packet detail, validation). Long operations (open, filter, sort) are not timed out but can be cancelled."
        },
        "pcapViewer.ai.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Offer AI help through VS Code's Language Model API (GitHub Copilot): display filters (the filter bar's \u2728 action, *PCAP: Suggest Display Filter\u2026* and `@pcap` in chat), where only your request, the current filter and protocol/field names are sent and suggestions are checked with tshark; and explaining packets (*Ask Copilot About This Packet\u2026*, `@pcap /explain`), which sends packet data only if `#pcapViewer.ai.allowPacketData#` allows it."
        },
        "pcapViewer.ai.allowPacketData": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "markdownDescription": "Allow *Ask Copilot About This Packet\u2026* and `@pcap /explain` to send packet data to the language model: for at most 8 packets at a time, their packet-list row and dissection tree (field names and values, at most 250 lines each), plus your question and the current display filter. Raw bytes are not sent unless `#pcapViewer.ai.allowPacketBytes#` is also on. You are asked once when this is off. User settings only."
        },
        "pcapViewer.ai.allowPacketBytes": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "When explaining packets (with `#pcapViewer.ai.allowPacketData#`), also send raw bytes: the first 256 bytes of each packet as hex, and payload fields as bytes. Off: the hex dump is never sent and payload bytes are replaced by \"[N bytes not sent]\". User settings only.",
          "scope": "application"
        }
      }
    },
    "snippets": [
      {
        "language": "lua",
        "path": "./snippets/lua-dissector.json"
      }
    ],
    "chatParticipants": [
      {
        "id": "pcapViewer.pcap",
        "name": "pcap",
        "fullName": "PCAP Viewer",
        "description": "Ask for a Wireshark display filter for the open capture, or /explain packets",
        "isSticky": false,
        "commands": [
          {
            "name": "explain",
            "description": "Explain packets of the open capture, e.g. /explain 12 15-17 why the reset? (sends packet data: pcapViewer.ai.allowPacketData)"
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src test && tsc -p tsconfig.webview.json",
    "test": "pnpm run test:unit && pnpm run test:backend",
    "test:unit": "pnpm run compile && mocha --ui tdd \"out/test/extension/unit/**/*.test.js\" \"test/webview/**/*.test.js\"",
    "test:backend": "uv run pytest",
    "test:extension": "pnpm run compile && node ./out/test/extension/runTest.js",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "@types/vscode": "~1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^10.11.0",
    "mocha": "^12.0.2",
    "playwright-core": "^1.63.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1"
  },
  "packageManager": "pnpm@12.6.0"
}
