{
  "name": "pcap-viewer",
  "displayName": "PCAP Viewer",
  "description": "Wireshark-like packet capture viewer for VS Code, powered by tshark.",
  "version": "0.1.0",
  "publisher": "denpaz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DenPaz/vsc_pcap_viewer"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "pcap",
    "pcapng",
    "wireshark",
    "tshark",
    "network"
  ],
  "main": "./out/src/extension.js",
  "activationEvents": [],
  "contributes": {
    "customEditors": [
      {
        "viewType": "pcapViewer.editor",
        "displayName": "PCAP Viewer",
        "selector": [
          {
            "filenamePattern": "*.pcap"
          },
          {
            "filenamePattern": "*.pcapng"
          },
          {
            "filenamePattern": "*.cap"
          },
          {
            "filenamePattern": "*.pcap.gz"
          },
          {
            "filenamePattern": "*.pcapng.gz"
          },
          {
            "filenamePattern": "*.pcap.zst"
          },
          {
            "filenamePattern": "*.pcapng.zst"
          },
          {
            "filenamePattern": "*.pcap.lz4"
          },
          {
            "filenamePattern": "*.pcapng.lz4"
          },
          {
            "filenamePattern": "*.ntar"
          },
          {
            "filenamePattern": "*.pcap[0-9]*"
          },
          {
            "filenamePattern": "*.snoop"
          },
          {
            "filenamePattern": "*.erf"
          },
          {
            "filenamePattern": "*.pklg"
          },
          {
            "filenamePattern": "*.btsnoop"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "pcapViewer.editorOptional",
        "displayName": "PCAP Viewer",
        "selector": [
          {
            "filenamePattern": "*.[0-9]"
          },
          {
            "filenamePattern": "*.log"
          },
          {
            "filenamePattern": "*.dmp"
          },
          {
            "filenamePattern": "*.trc"
          },
          {
            "filenamePattern": "*.ber"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "pcapViewer.applyFilter",
        "title": "Apply Display Filter",
        "category": "PCAP"
      },
      {
        "command": "pcapViewer.clearFilter",
        "title": "Clear Display Filter",
        "category": "PCAP"
      },
      {
        "command": "pcapViewer.goToPacket",
        "title": "Go to Packet",
        "category": "PCAP"
      },
      {
        "command": "pcapViewer.saveFilter",
        "title": "Save Display Filter\u2026",
        "category": "PCAP"
      },
      {
        "command": "pcapViewer.savedFilters",
        "title": "Saved Display Filters",
        "category": "PCAP"
      },
      {
        "command": "pcapViewer.followStream",
        "title": "Follow Stream\u2026",
        "category": "PCAP"
      },
      {
        "command": "pcapViewer.followTcpStream",
        "title": "Follow TCP Stream",
        "category": "PCAP"
      },
      {
        "command": "pcapViewer.followUdpStream",
        "title": "Follow UDP Stream",
        "category": "PCAP"
      },
      {
        "command": "pcapViewer.followTlsStream",
        "title": "Follow TLS Stream",
        "category": "PCAP"
      },
      {
        "command": "pcapViewer.followHttpStream",
        "title": "Follow HTTP Stream",
        "category": "PCAP"
      },
      {
        "command": "pcapViewer.statistics.conversations",
        "title": "Conversations",
        "category": "PCAP Statistics"
      },
      {
        "command": "pcapViewer.statistics.endpoints",
        "title": "Endpoints",
        "category": "PCAP Statistics"
      },
      {
        "command": "pcapViewer.statistics.protocolHierarchy",
        "title": "Protocol Hierarchy",
        "category": "PCAP Statistics"
      },
      {
        "command": "pcapViewer.statistics.ioGraph",
        "title": "I/O Graph",
        "category": "PCAP Statistics"
      },
      {
        "command": "pcapViewer.statistics.expertInfo",
        "title": "Expert Information",
        "category": "PCAP Statistics"
      },
      {
        "command": "pcapViewer.statistics.captureProperties",
        "title": "Capture File Properties",
        "category": "PCAP Statistics"
      },
      {
        "command": "pcapViewer.reloadDissectors",
        "title": "Reload Dissectors",
        "category": "PCAP"
      },
      {
        "command": "pcapViewer.newLuaDissector",
        "title": "New Lua Dissector\u2026",
        "category": "PCAP"
      },
      {
        "command": "pcapViewer.openDissectorsFolder",
        "title": "Open Dissectors Folder",
        "category": "PCAP"
      },
      {
        "command": "pcapViewer.decodeAs",
        "title": "Decode As\u2026",
        "category": "PCAP"
      },
      {
        "command": "pcapViewer.manageDecodeAs",
        "title": "Manage Decode As Rules",
        "category": "PCAP"
      },
      {
        "command": "pcapViewer.manageColumns",
        "title": "Manage Custom Columns",
        "category": "PCAP"
      },
      {
        "command": "pcapViewer.exportFiltered",
        "title": "Export Specified Packets\u2026",
        "category": "PCAP"
      },
      {
        "command": "pcapViewer.exportPacketList",
        "title": "Export Packet List as CSV/JSON\u2026",
        "category": "PCAP"
      },
      {
        "command": "pcapViewer.exportPacketBytes",
        "title": "Export Packet Bytes\u2026",
        "category": "PCAP"
      },
      {
        "command": "pcapViewer.colorizeWithFilter",
        "title": "Colorize with Filter\u2026",
        "category": "PCAP"
      },
      {
        "command": "pcapViewer.toggleColoring",
        "title": "Toggle Packet Coloring",
        "category": "PCAP"
      },
      {
        "command": "pcapViewer.manageColoringRules",
        "title": "Manage Coloring Rules",
        "category": "PCAP"
      },
      {
        "command": "pcapViewer.reload",
        "title": "Reload Capture",
        "category": "PCAP"
      },
      {
        "command": "pcapViewer.showLog",
        "title": "Show Log",
        "category": "PCAP"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "pcapViewer.applyFilter",
          "when": "activeCustomEditorId =~ /^pcapViewer\\.editor(Optional)?$/"
        },
        {
          "command": "pcapViewer.clearFilter",
          "when": "activeCustomEditorId =~ /^pcapViewer\\.editor(Optional)?$/"
        },
        {
          "command": "pcapViewer.goToPacket",
          "when": "activeCustomEditorId =~ /^pcapViewer\\.editor(Optional)?$/"
        },
        {
          "command": "pcapViewer.reload",
          "when": "activeCustomEditorId =~ /^pcapViewer\\.editor(Optional)?$/"
        },
        {
          "command": "pcapViewer.saveFilter",
          "when": "activeCustomEditorId =~ /^pcapViewer\\.editor(Optional)?$/"
        },
        {
          "command": "pcapViewer.followStream",
          "when": "activeCustomEditorId =~ /^pcapViewer\\.editor(Optional)?$/ || activeWebviewPanelId == pcapViewer.stats || activeWebviewPanelId == pcapViewer.follow"
        },
        {
          "command": "pcapViewer.followTcpStream",
          "when": "activeCustomEditorId =~ /^pcapViewer\\.editor(Optional)?$/ || activeWebviewPanelId == pcapViewer.stats || activeWebviewPanelId == pcapViewer.follow"
        },
        {
          "command": "pcapViewer.followUdpStream",
          "when": "activeCustomEditorId =~ /^pcapViewer\\.editor(Optional)?$/ || activeWebviewPanelId == pcapViewer.stats || activeWebviewPanelId == pcapViewer.follow"
        },
        {
          "command": "pcapViewer.followTlsStream",
          "when": "activeCustomEditorId =~ /^pcapViewer\\.editor(Optional)?$/ || activeWebviewPanelId == pcapViewer.stats || activeWebviewPanelId == pcapViewer.follow"
        },
        {
          "command": "pcapViewer.followHttpStream",
          "when": "activeCustomEditorId =~ /^pcapViewer\\.editor(Optional)?$/ || activeWebviewPanelId == pcapViewer.stats || activeWebviewPanelId == pcapViewer.follow"
        },
        {
          "command": "pcapViewer.statistics.conversations",
          "when": "activeCustomEditorId =~ /^pcapViewer\\.editor(Optional)?$/ || activeWebviewPanelId == pcapViewer.stats || activeWebviewPanelId == pcapViewer.follow"
        },
        {
          "command": "pcapViewer.statistics.endpoints",
          "when": "activeCustomEditorId =~ /^pcapViewer\\.editor(Optional)?$/ || activeWebviewPanelId == pcapViewer.stats || activeWebviewPanelId == pcapViewer.follow"
        },
        {
          "command": "pcapViewer.statistics.protocolHierarchy",
          "when": "activeCustomEditorId =~ /^pcapViewer\\.editor(Optional)?$/ || activeWebviewPanelId == pcapViewer.stats || activeWebviewPanelId == pcapViewer.follow"
        },
        {
          "command": "pcapViewer.statistics.ioGraph",
          "when": "activeCustomEditorId =~ /^pcapViewer\\.editor(Optional)?$/ || activeWebviewPanelId == pcapViewer.stats || activeWebviewPanelId == pcapViewer.follow"
        },
        {
          "command": "pcapViewer.statistics.expertInfo",
          "when": "activeCustomEditorId =~ /^pcapViewer\\.editor(Optional)?$/ || activeWebviewPanelId == pcapViewer.stats || activeWebviewPanelId == pcapViewer.follow"
        },
        {
          "command": "pcapViewer.statistics.captureProperties",
          "when": "activeCustomEditorId =~ /^pcapViewer\\.editor(Optional)?$/ || activeWebviewPanelId == pcapViewer.stats || activeWebviewPanelId == pcapViewer.follow"
        },
        {
          "command": "pcapViewer.decodeAs",
          "when": "activeCustomEditorId =~ /^pcapViewer\\.editor(Optional)?$/ || activeWebviewPanelId == pcapViewer.stats || activeWebviewPanelId == pcapViewer.follow"
        },
        {
          "command": "pcapViewer.exportFiltered",
          "when": "activeCustomEditorId =~ /^pcapViewer\\.editor(Optional)?$/ || activeWebviewPanelId == pcapViewer.stats || activeWebviewPanelId == pcapViewer.follow"
        },
        {
          "command": "pcapViewer.exportPacketList",
          "when": "activeCustomEditorId =~ /^pcapViewer\\.editor(Optional)?$/ || activeWebviewPanelId == pcapViewer.stats || activeWebviewPanelId == pcapViewer.follow"
        },
        {
          "command": "pcapViewer.exportPacketBytes",
          "when": "activeCustomEditorId =~ /^pcapViewer\\.editor(Optional)?$/ || activeWebviewPanelId == pcapViewer.stats || activeWebviewPanelId == pcapViewer.follow"
        },
        {
          "command": "pcapViewer.colorizeWithFilter",
          "when": "activeCustomEditorId =~ /^pcapViewer\\.editor(Optional)?$/ || activeWebviewPanelId == pcapViewer.stats || activeWebviewPanelId == pcapViewer.follow"
        },
        {
          "command": "pcapViewer.toggleColoring",
          "when": "activeCustomEditorId =~ /^pcapViewer\\.editor(Optional)?$/ || activeWebviewPanelId == pcapViewer.stats || activeWebviewPanelId == pcapViewer.follow"
        }
      ]
    },
    "keybindings": [
      {
        "command": "pcapViewer.applyFilter",
        "key": "ctrl+/",
        "mac": "cmd+/",
        "when": "activeCustomEditorId =~ /^pcapViewer\\.editor(Optional)?$/"
      },
      {
        "command": "pcapViewer.goToPacket",
        "key": "ctrl+g",
        "mac": "cmd+g",
        "when": "activeCustomEditorId =~ /^pcapViewer\\.editor(Optional)?$/"
      }
    ],
    "configuration": {
      "title": "PCAP Viewer",
      "properties": {
        "pcapViewer.pythonPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Python 3.14+ interpreter used to run the backend. Empty: try `python3.14`, `python3`, `python` (or `py -3.14` / `py -3` on Windows) from `PATH`."
        },
        "pcapViewer.tsharkPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Path to `tshark`. Empty: search `PATH` and the default Wireshark install locations."
        },
        "pcapViewer.luaScripts": {
          "type": "array",
          "scope": "resource",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Lua dissector scripts passed to tshark as `-X lua_script:<path>`. Relative paths resolve against the first workspace folder."
        },
        "pcapViewer.dissectorsFolder": {
          "type": "string",
          "scope": "resource",
          "default": "",
          "markdownDescription": "Folder whose `*.lua` files are loaded as dissectors in addition to `#pcapViewer.luaScripts#`. Relative paths resolve against the first workspace folder."
        },
        "pcapViewer.decodeAs": {
          "type": "array",
          "scope": "resource",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.\\-]*(==|:)[^,\\s]+,[A-Za-z0-9_.\\-]+$",
            "patternErrorMessage": "Expected <layer>==<value>,<protocol>, e.g. tcp.port==8080,http"
          },
          "default": [],
          "markdownDescription": "\"Decode As\" rules passed to tshark as `-d`, e.g. `tcp.port==8080,http`."
        },
        "pcapViewer.prefs": {
          "type": "object",
          "scope": "resource",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          "default": {},
          "markdownDescription": "Wireshark preference overrides passed as `-o <name>:<value>`, e.g. `{ \"tcp.desegment_tcp_streams\": false }`."
        },
        "pcapViewer.columns": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "field": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  }
                },
                "required": [
                  "field"
                ]
              }
            ]
          },
          "default": [],
          "markdownDescription": "Extra packet-list columns: any tshark field (e.g. `tcp.stream`, `http.host`) or `{ \"field\": \"http.host\", \"title\": \"Host\" }`."
        },
        "pcapViewer.savedFilters": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "filter": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "filter"
            ]
          },
          "default": [],
          "markdownDescription": "Named display filters, e.g. `{ \"name\": \"Web\", \"filter\": \"http || tls\" }`. Shown in the filter bar's \u2605 menu and *PCAP: Saved Display Filters*. Set in user settings for all captures or in workspace settings to share with a project."
        },
        "pcapViewer.colorize": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "Color the packet list with `#pcapViewer.coloringRules#` (*PCAP: Toggle Packet Coloring*)."
        },
        "pcapViewer.coloringRules": {
          "type": "array",
          "scope": "resource",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "filter": {
                "type": "string",
                "description": "Display filter"
              },
              "foreground": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$",
                "patternErrorMessage": "Use a #rrggbb color",
                "description": "Text color"
              },
              "background": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$",
                "patternErrorMessage": "Use a #rrggbb color",
                "description": "Row color"
              },
              "enabled": {
                "type": "boolean",
                "default": true
              }
            },
            "required": [
              "name",
              "filter"
            ]
          },
          "default": [
            {
              "name": "Bad TCP",
              "filter": "tcp.analysis.flags && !tcp.analysis.window_update && !tcp.analysis.keep_alive && !tcp.analysis.keep_alive_ack",
              "foreground": "#f78787",
              "background": "#12272e"
            },
            {
              "name": "Checksum Errors",
              "filter": "eth.fcs.status == \"Bad\" || ip.checksum.status == \"Bad\" || tcp.checksum.status == \"Bad\" || udp.checksum.status == \"Bad\" || sctp.checksum.status == \"Bad\"",
              "foreground": "#f78787",
              "background": "#12272e"
            },
            {
              "name": "TCP RST",
              "filter": "tcp.flags.reset == 1",
              "foreground": "#fffc9c",
              "background": "#a40000"
            },
            {
              "name": "ICMP errors",
              "filter": "icmp.type == 3 || icmp.type == 4 || icmp.type == 5 || icmp.type == 11 || (icmpv6.type >= 1 && icmpv6.type <= 4)",
              "foreground": "#b7f774",
              "background": "#12272e"
            },
            {
              "name": "ARP",
              "filter": "arp",
              "foreground": "#12272e",
              "background": "#faf0d7"
            },
            {
              "name": "ICMP",
              "filter": "icmp || icmpv6",
              "foreground": "#12272e",
              "background": "#fce0ff"
            },
            {
              "name": "TCP SYN/FIN",
              "filter": "tcp.flags & 0x02 || tcp.flags.fin == 1",
              "foreground": "#12272e",
              "background": "#a0a0a0"
            },
            {
              "name": "HTTP",
              "filter": "http || tcp.port == 80 || http2",
              "foreground": "#12272e",
              "background": "#e4ffc7"
            },
            {
              "name": "DNS",
              "filter": "dns || mdns || llmnr",
              "foreground": "#12272e",
              "background": "#c8e2ff"
            },
            {
              "name": "SMB",
              "filter": "smb || nbss || nbns || netbios",
              "foreground": "#12272e",
              "background": "#feffd0"
            },
            {
              "name": "Routing",
              "filter": "hsrp || eigrp || ospf || bgp || cdp || vrrp || carp || gvrp || igmp || ismp",
              "foreground": "#12272e",
              "background": "#fff3d6"
            },
            {
              "name": "TCP",
              "filter": "tcp",
              "foreground": "#12272e",
              "background": "#e7e6ff"
            },
            {
              "name": "UDP",
              "filter": "udp",
              "foreground": "#12272e",
              "background": "#daeeff"
            },
            {
              "name": "Broadcast",
              "filter": "eth[0] & 1",
              "foreground": "#babdb6",
              "background": "#ffffff"
            }
          ],
          "markdownDescription": "Packet list coloring rules, like Wireshark's *View \u203a Coloring Rules*: the **first** rule whose display filter matches colors the packet. Colors are `#rrggbb`; set `\"enabled\": false` to keep a rule without using it. *Colorize with Filter\u2026* in the detail tree's context menu adds a rule at the top."
        },
        "pcapViewer.maxCachedFrames": {
          "type": "integer",
          "default": 5000000,
          "minimum": 10000,
          "markdownDescription": "Budget (in frame numbers) for cached filter results and sort orders in the backend. Each entry costs 4 bytes."
        },
        "pcapViewer.requestTimeoutSeconds": {
          "type": "integer",
          "default": 60,
          "minimum": 5,
          "markdownDescription": "Timeout for quick backend requests (packet detail, validation). Long operations (open, filter, sort) are not timed out but can be cancelled."
        }
      }
    },
    "snippets": [
      {
        "language": "lua",
        "path": "./snippets/lua-dissector.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src test && tsc -p tsconfig.webview.json",
    "test": "pnpm run test:unit && pnpm run test:backend",
    "test:unit": "pnpm run compile && mocha --ui tdd \"out/test/extension/unit/**/*.test.js\" \"test/webview/**/*.test.js\"",
    "test:backend": "uv run pytest",
    "test:extension": "pnpm run compile && node ./out/test/extension/runTest.js",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "@types/vscode": "~1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^10.11.0",
    "mocha": "^12.0.2",
    "playwright-core": "^1.63.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1"
  },
  "packageManager": "pnpm@12.6.0"
}
