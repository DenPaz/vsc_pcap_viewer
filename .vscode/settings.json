{
  // Run the npm tasks in tasks.json (and the npm scripts explorer) with pnpm.
  "npm.packageManager": "pnpm",
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  // Format on save with the project's formatters (.prettierrc.json, pyproject.toml).
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "prettier.requireConfig": true,
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.codeActionsOnSave": { "source.organizeImports.ruff": "explicit" }
  }
}
